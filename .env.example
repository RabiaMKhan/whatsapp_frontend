# Copy to .env.local. NEXT_PUBLIC_* values are sent to the browser, so no secrets here.

# Local development: the API runs on its own port.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: only if Socket.io runs on a different origin than the API
# NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Production (Vercel) with the API on another site (e.g. Render):
#   NEXT_PUBLIC_API_URL=/                                   (call /api on this site)
#   API_PROXY_TARGET=https://relay-api.onrender.com         (where /api is forwarded; read at build time)
#   NEXT_PUBLIC_SOCKET_URL=https://relay-api.onrender.com   (WebSockets go straight to the API)
