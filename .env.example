# Copy to .env.local. NEXT_PUBLIC_* values are sent to the browser, so no secrets here.

# Local development: the API runs on its own port.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Production (Vercel), with the API in its own Vercel project:
#   NEXT_PUBLIC_API_URL=/                                 (call /api on this site)
#   API_PROXY_TARGET=https://<api-project>.vercel.app     (where /api is forwarded; read at build time)
# Real-time updates use Ably; the API hands out tokens, so the web app needs no Ably settings.
